# Copy this file to .env and adjust values for your local machine.
# .env is git-ignored — never commit real secrets or machine-specific paths here.

# --- Test environment selector -------------------------------------------
# LOCAL | CI
TEST_ENV=LOCAL

# --- Appium server ---------------------------------------------------------
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/

# --- Device / platform capabilities ----------------------------------------
PLATFORM_NAME=Android
AUTOMATION_NAME=UiAutomator2
DEVICE_NAME=emulator-5554
PLATFORM_VERSION=13.0

# --- Application under test -------------------------------------------------
# Path to the ApiDemos APK, relative to the project root or absolute.
APP_PATH=./apps/ApiDemos-debug.apk
APP_PACKAGE=io.appium.android.apis
APP_ACTIVITY=.ApiDemos

# --- Session behaviour -------------------------------------------------------
AUTO_GRANT_PERMISSIONS=true
NO_RESET=false
FULL_RESET=false
NEW_COMMAND_TIMEOUT=120

# --- Timeouts (milliseconds) -------------------------------------------------
IMPLICIT_WAIT_MS=0
DEFAULT_TIMEOUT_MS=15000
