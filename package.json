{
  "name": "appium-typescript-framework",
  "version": "1.0.0",
  "description": "Production-grade Android mobile automation framework using TypeScript, WebdriverIO, Appium 2 and UiAutomator2 against the Android ApiDemos sample app.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "test": "npm run test:local",
    "test:local": "wdio run ./config/wdio.local.conf.ts",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:smoke": "wdio run ./config/wdio.android.conf.ts --spec test/specs/smoke/smoke.spec.ts",
    "test:regression": "wdio run ./config/wdio.android.conf.ts --spec test/specs/regression/regression.spec.ts",
    "test:smoke:local": "wdio run ./config/wdio.local.conf.ts --spec test/specs/smoke/smoke.spec.ts",
    "test:regression:local": "wdio run ./config/wdio.local.conf.ts --spec test/specs/regression/regression.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "appium:install-driver": "appium driver install uiautomator2@4.2.9",
    "appium:start": "appium server --port 4723 --relaxed-security",
    "clean": "rimraf allure-results allure-report screenshots logs reports"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/chai": "^5.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/globals": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mcp": "^1.0.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "@wdio/types": "^9.4.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^4.2.9",
    "chai": "^5.1.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1",
    "webdriverio": "^9.4.0"
  }
}
